# PickForMe 環境變數設定範本

# 系統環境 ('development' | 'production' | 'test')
ENVIRONMENT=development

# Neon Serverless Postgres 資料庫連線字串
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/pickforme?sslmode=require

# Telegram Bot 設定
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=123456789

# API 金鑰
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 選擇性：GCS Bucket 名稱 (Phase B 冷層)
GCS_BUCKET_NAME=pickforme-cold-archive
