# PickForMe 環境變數設定範本

# 系統環境 ('development' | 'production' | 'test')
ENVIRONMENT=development

# Neon Serverless Postgres 資料庫連線字串
DATABASE_URL=postgresql://user:password@localhost:5432/pickforme

# Telegram Bot 設定
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# API 金鑰
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# 選擇性：GCS Bucket 名稱 (Phase B 冷層)
GCS_BUCKET_NAME=pickforme-cold-archive

# LLM 模型提供者 ('groq' | 'gemini' | 'ollama')與熱切換模型清單
LLM_PRIMARY_PROVIDER=groq
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.8-flash

# 本機 Ollama 離線模型設定 (選擇性)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_ENABLED=true
